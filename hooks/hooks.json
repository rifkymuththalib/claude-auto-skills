{
  "description": "Auto Skills - review finished sessions and induce skills from them",
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/on_session_end.sh",
            "timeout": 10,
            "async": true,
            "statusMessage": "Auto Skills: queueing session review"
          }
        ]
      }
    ]
  }
}
